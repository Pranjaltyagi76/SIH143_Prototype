# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# If a credential is ever committed, ROTATE IT -- removing it from history is
# not sufficient. See Context/security_review.md section 4.
#
# All four services are FREE. Registration only, no payment method.

# Copernicus Data Space Ecosystem -- Sentinel-1 GRD
# https://dataspace.copernicus.eu   (NOT Sentinel Hub, which has paid tiers)
CDSE_USERNAME=
CDSE_PASSWORD=

# Copernicus Marine Service -- SMOC currents
# https://marine.copernicus.eu
CMEMS_USERNAME=
CMEMS_PASSWORD=

# Climate Data Store -- ERA5 10 m wind
# https://cds.climate.copernicus.eu
# You must also ACCEPT THE LICENCE in your CDS account or downloads 403.
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
