# Secrets
.env
*.key
credentials.json

# Data (never commit datasets - see Context/security_review.md)
# 'data/*' not 'data/' -- git cannot re-include a file whose parent DIRECTORY
# is excluded, so 'data/' plus '!data/.gitkeep' silently keeps nothing.
data/*
!data/.gitkeep
*.nc
*.tif
*.tiff
*.SAFE/
*.zip

# Model weights
models/
*.pt
*.pth
*.ckpt

# Pipeline output
# NOTE: these patterns are anchored on purpose. Unanchored 'eval/' matches
# src/eval/ (the evaluation harness) and unanchored 'vendor/' matches
# web/vendor/, silently excluding real source from the repo.
out/
/eval/
web/vendor/*
!web/vendor/.gitkeep

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Node (not used, but just in case)
node_modules/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
